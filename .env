FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=TU_CLAVE_SECRETA_CLIENTE # Una clave diferente para el cliente Flask

# URL base de la API RESTful (¡La API se ejecutará en el puerto 5001!)
API_BASE_URL=http://localhost:5001

# --- Configuración de Correo Electrónico (Flask-Mail) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=tu_email@example.com
MAIL_PASSWORD=tu_contraseña_de_email_o_app
MAIL_DEFAULT_SENDER=tu_email@example.com

# --- Configuración de Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0